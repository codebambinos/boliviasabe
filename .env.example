# Copy to .env and fill in. Never commit .env.
# VITE_* variables are bundled into the browser: only put public values there.

# --- Data source --------------------------------------------------------------
# mock (default) or supabase. With supabase only `auth` is real (T15); the rest still uses the mock
# until its own task lands. Auth settings in the dashboard: see supabase/README.md › Auth setup.
VITE_DATA_SOURCE=mock

# --- Supabase ---------------------------------------------------------------
# New projects may issue sb_publishable_ / sb_secret_ keys: use them in place of anon / service_role.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Server only (Vercel functions and scripts). Bypasses RLS: never expose it.
SUPABASE_SERVICE_ROLE_KEY=

# --- Stellar testnet (created by `npm run stellar:setup`) -------------------
YAPITA_ISSUER_SECRET=
YAPITA_DISTRIBUTOR_SECRET=
YAPITA_ISSUER_PUBLIC=
YAPITA_DISTRIBUTOR_PUBLIC=
# Public value: lets the browser tell YAPITA from a look-alike when it reads the balance from Horizon.
VITE_YAPITA_ISSUER_PUBLIC=

# 32 random bytes in base64 (AES-256-GCM key for custodied user keys).
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
WALLET_ENC_KEY=

# --- Web Push (VAPID) -------------------------------------------------------
# Generate with: npx web-push generate-vapid-keys
VITE_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Shared with the database (Supabase Vault `push_secret`): only pg_net may call /api/push (SPEC 15).
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
PUSH_WEBHOOK_SECRET=

# --- Reminder endpoint (called hourly by Supabase pg_cron) ------------------
CRON_SECRET=

# --- Seed (`npm run seed`) --------------------------------------------------
# Password of the 5 example neighbors (lucia@example.com, …). Share it with the team, never commit it.
SEED_PASSWORD=
